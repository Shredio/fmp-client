{
	"name": "shredio/fmp-client",
	"type": "library",
	"license": "MIT",
	"require": {
		"php": ">=8.3",
		"symfony/http-client": "^7.2",
		"halaxa/json-machine": "^1.2",
		"league/csv": "^9.24",
		"shredio/type-schema": "^0.9.2"
	},
	"autoload": {
		"psr-4": {
			"Shredio\\FmpClient\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse --memory-limit=-1",
		"test": "vendor/bin/phpunit tests",
		"compile": "vendor/bin/type-schema-compile src/Payload src/Mapper Shredio\\\\FmpClient\\\\Mapper\\\\%sMapper"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^12.2",
		"phpstan/phpstan-webmozart-assert": "^2.0",
		"nette/utils": "^4.0",
		"shredio/type-schema-compiler": "dev-master",
		"symfony/translation": "^7.3"
	}
}
